<!-- Object Library: individual body definitions to be included in scenes.
     Each object is a free-body that can be placed anywhere.
     Naming convention: each body name matches the object identifier.
-->
<mujoco>
  <!-- ============================== DRINKWARE ============================== -->

  <!-- Mug: cylindrical with handle -->
  <body name="mug" pos="0 0 0">
    <freejoint name="mug_free"/>
    <geom name="mug_body" type="cylinder" size="0.035 0.045"
          material="mat_ceramic_blue" mass="0.25"/>
    <geom name="mug_handle" type="capsule" size="0.006" fromto="0.035 0 -0.02 0.055 0 0.02"
          material="mat_ceramic_blue"/>
    <site name="mug_grasp" pos="0 0 0.045" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Cup: shorter cylinder, no handle -->
  <body name="cup" pos="0 0 0">
    <freejoint name="cup_free"/>
    <geom name="cup_body" type="cylinder" size="0.032 0.04"
          material="mat_ceramic_white" mass="0.2"/>
    <site name="cup_grasp" pos="0 0 0.04" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Glass: taller, transparent-ish -->
  <body name="glass" pos="0 0 0">
    <freejoint name="glass_free"/>
    <geom name="glass_body" type="cylinder" size="0.03 0.055"
          material="mat_glass_clear" mass="0.2"/>
    <site name="glass_grasp" pos="0 0 0.055" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- ============================== SERVEWARE ============================== -->

  <!-- Plate: flat disc -->
  <body name="plate" pos="0 0 0">
    <freejoint name="plate_free"/>
    <geom name="plate_body" type="cylinder" size="0.09 0.008"
          material="mat_ceramic_white" mass="0.4"/>
    <site name="plate_grasp" pos="0 0 0.008" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Small plate -->
  <body name="small_plate" pos="0 0 0">
    <freejoint name="small_plate_free"/>
    <geom name="small_plate_body" type="cylinder" size="0.065 0.006"
          material="mat_ceramic_white" mass="0.25"/>
    <site name="small_plate_grasp" pos="0 0 0.006" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Bowl -->
  <body name="bowl" pos="0 0 0">
    <freejoint name="bowl_free"/>
    <geom name="bowl_body" type="cylinder" size="0.055 0.03"
          material="mat_ceramic_white" mass="0.3"/>
    <site name="bowl_grasp" pos="0 0 0.03" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- ============================== UTENSILS ============================== -->

  <!-- Spoon -->
  <body name="spoon" pos="0 0 0">
    <freejoint name="spoon_free"/>
    <geom name="spoon_handle" type="capsule" size="0.005" fromto="0 0 0 0.15 0 0"
          material="mat_steel" mass="0.05"/>
    <geom name="spoon_head" type="ellipsoid" size="0.015 0.012 0.004"
          pos="0.165 0 0" material="mat_steel"/>
    <site name="spoon_grasp" pos="0.07 0 0" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Fork -->
  <body name="fork" pos="0 0 0">
    <freejoint name="fork_free"/>
    <geom name="fork_handle" type="capsule" size="0.005" fromto="0 0 0 0.13 0 0"
          material="mat_steel" mass="0.04"/>
    <geom name="fork_head" type="box" size="0.012 0.01 0.003"
          pos="0.15 0 0" material="mat_steel"/>
    <site name="fork_grasp" pos="0.065 0 0" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Knife -->
  <body name="knife" pos="0 0 0">
    <freejoint name="knife_free"/>
    <geom name="knife_handle" type="capsule" size="0.006" fromto="0 0 0 0.08 0 0"
          material="mat_plastic_red" mass="0.04"/>
    <geom name="knife_blade" type="box" size="0.06 0.012 0.001"
          pos="0.14 0 0" material="mat_steel"/>
    <site name="knife_grasp" pos="0.04 0 0" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Stirrer: thin stick -->
  <body name="stirrer" pos="0 0 0">
    <freejoint name="stirrer_free"/>
    <geom name="stirrer_body" type="capsule" size="0.003" fromto="0 0 0 0.14 0 0"
          material="mat_plastic_red" mass="0.01"/>
    <site name="stirrer_grasp" pos="0.07 0 0" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Spatula -->
  <body name="spatula" pos="0 0 0">
    <freejoint name="spatula_free"/>
    <geom name="spatula_handle" type="capsule" size="0.006" fromto="0 0 0 0.12 0 0"
          material="mat_plastic_green" mass="0.06"/>
    <geom name="spatula_head" type="box" size="0.03 0.025 0.002"
          pos="0.155 0 0" material="mat_plastic_green"/>
    <site name="spatula_grasp" pos="0.06 0 0" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Tongs -->
  <body name="tongs" pos="0 0 0">
    <freejoint name="tongs_free"/>
    <geom name="tongs_arm1" type="capsule" size="0.005" fromto="0 -0.005 0 0.17 -0.005 0"
          material="mat_steel" mass="0.08"/>
    <geom name="tongs_arm2" type="capsule" size="0.005" fromto="0 0.005 0 0.17 0.005 0"
          material="mat_steel"/>
    <site name="tongs_grasp" pos="0.04 0 0" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- ============================== INGREDIENTS / FOOD ============================== -->

  <!-- Kettle -->
  <body name="kettle" pos="0 0 0">
    <freejoint name="kettle_free"/>
    <geom name="kettle_body" type="cylinder" size="0.05 0.07"
          material="mat_steel" mass="0.8"/>
    <geom name="kettle_spout" type="capsule" size="0.008" fromto="0.05 0 0.03 0.08 0 0.06"
          material="mat_steel"/>
    <geom name="kettle_handle" type="capsule" size="0.006"
          fromto="-0.03 0 0.07 0.03 0 0.10" material="mat_plastic_red"/>
    <site name="kettle_grasp" pos="0 0 0.10" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Coffee jar -->
  <body name="coffee_jar" pos="0 0 0">
    <freejoint name="coffee_jar_free"/>
    <geom name="coffee_jar_body" type="cylinder" size="0.03 0.045"
          material="mat_jar_brown" mass="0.3"/>
    <geom name="coffee_jar_lid" type="cylinder" size="0.032 0.005"
          pos="0 0 0.05" material="mat_plastic_red"/>
    <site name="coffee_jar_grasp" pos="0 0 0.05" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Sugar jar -->
  <body name="sugar_jar" pos="0 0 0">
    <freejoint name="sugar_jar_free"/>
    <geom name="sugar_jar_body" type="cylinder" size="0.03 0.04"
          material="mat_jar_white" mass="0.3"/>
    <geom name="sugar_jar_lid" type="cylinder" size="0.032 0.005"
          pos="0 0 0.045" material="mat_plastic_yellow"/>
    <site name="sugar_jar_grasp" pos="0 0 0.045" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Milk carton -->
  <body name="milk_carton" pos="0 0 0">
    <freejoint name="milk_carton_free"/>
    <geom name="milk_body" type="box" size="0.03 0.03 0.06"
          material="mat_ceramic_white" mass="0.5"/>
    <geom name="milk_cap" type="cylinder" size="0.01 0.005"
          pos="0.015 0 0.065" material="mat_plastic_green"/>
    <site name="milk_grasp" pos="0 0 0.06" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Tea box -->
  <body name="tea_box" pos="0 0 0">
    <freejoint name="tea_box_free"/>
    <geom name="tea_box_body" type="box" size="0.04 0.025 0.03"
          material="mat_plastic_green" mass="0.15"/>
    <site name="tea_box_grasp" pos="0 0 0.03" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Bread -->
  <body name="bread" pos="0 0 0">
    <freejoint name="bread_free"/>
    <geom name="bread_body" type="box" size="0.05 0.04 0.025"
          material="mat_bread" mass="0.3"/>
    <site name="bread_grasp" pos="0 0 0.025" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Butter -->
  <body name="butter" pos="0 0 0">
    <freejoint name="butter_free"/>
    <geom name="butter_body" type="box" size="0.03 0.02 0.015"
          material="mat_butter" mass="0.15"/>
    <site name="butter_grasp" pos="0 0 0.015" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Jam jar -->
  <body name="jam_jar" pos="0 0 0">
    <freejoint name="jam_jar_free"/>
    <geom name="jam_jar_body" type="cylinder" size="0.03 0.04"
          material="mat_plastic_red" mass="0.35"/>
    <geom name="jam_jar_lid" type="cylinder" size="0.032 0.005"
          pos="0 0 0.045" material="mat_steel"/>
    <site name="jam_jar_grasp" pos="0 0 0.045" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Napkin -->
  <body name="napkin" pos="0 0 0">
    <freejoint name="napkin_free"/>
    <geom name="napkin_body" type="box" size="0.06 0.06 0.003"
          material="mat_ceramic_white" mass="0.02"/>
    <site name="napkin_grasp" pos="0 0 0.003" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Biscuits (small box) -->
  <body name="biscuits" pos="0 0 0">
    <freejoint name="biscuits_free"/>
    <geom name="biscuits_body" type="box" size="0.035 0.025 0.02"
          material="mat_cardboard" mass="0.1"/>
    <site name="biscuits_grasp" pos="0 0 0.02" size="0.01" type="sphere"
          rgba="0 0 0 0" group="5"/>
  </body>

  <!-- Pot with soup -->
  <body name="pot_with_soup" pos="0 0 0">
    <freejoint name="pot_free"/>
    <geom name="pot_body" type="cylinder" size="0.06 0.05"
          material="mat_steel" mass="1.5"/>
    <geom name="pot_handle_l" type="capsule" size="0.006"
          fromto="-0.06 0 0.02 -0.08 0 0.04" material="mat_steel"/>
    <geom name="pot_handle_r" type="capsule" size="0.006"
          fromto="0.06 0 0.02 0.08 0 0.04" material="mat_steel"/>
    <site name="pot_grasp" pos="0 0 0.05" size="0.01" type="sphere" rgba="0 0 0 0" group="5"/>
  </body>
</mujoco>

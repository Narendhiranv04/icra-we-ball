      <site name="living_room_mug_grasp" pos="0 0 0.025" size="0.01"
            rgba="0 0 0 0" group="5"/>
    </body>

    <body name="hardback_book" pos="0.02 -0.30 0.507">
      <freejoint name="hardback_book_free"/>
      <geom name="hardback_book_collision" type="box" size="0.125 0.080 0.018"
            material="book" mass="0.22" friction="1.0 0.04 0.01"/>
      <geom name="hardback_pages" class="visual" type="box" size="0.117 0.076 0.014"

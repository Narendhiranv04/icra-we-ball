      <geom name="game_controller_dpad_h" class="visual" type="box"
            size="0.022 0.007 0.004" pos="-0.033 0.003 0.024"
            rgba="0.05 0.05 0.06 1"/>
      <geom name="game_controller_dpad_v" class="visual" type="box"
            size="0.007 0.022 0.004" pos="-0.033 0.003 0.024"

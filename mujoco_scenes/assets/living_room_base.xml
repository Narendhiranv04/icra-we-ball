      <geom name="game_controller_stick_left" class="visual" type="cylinder"
            size="0.010 0.006" pos="-0.018 -0.022 0.024"
            rgba="0.04 0.04 0.05 1"/>
      <geom name="game_controller_stick_right" class="visual" type="cylinder"
            size="0.010 0.006" pos="0.018 -0.022 0.024"
            rgba="0.04 0.04 0.05 1"/>
      <geom name="game_controller_button_n" class="visual" type="cylinder"

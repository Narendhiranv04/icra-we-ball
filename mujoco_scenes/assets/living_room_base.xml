      <geom name="game_controller_button_w" class="visual" type="cylinder"
            size="0.005 0.004" pos="0.028 0.006 0.024" rgba="0.86 0.70 0.20 1"/>
      <site name="game_controller_grasp" pos="0 0 0.022" size="0.010"
            rgba="0 0 0 0" group="5"/>
    </body>

    <!-- A clean wall-mounted ledge beside the TV.  The shallow overlap with
         the feature wall makes it read as attached rather than floating. -->
    <body name="media_book_shelf">
      <geom name="media_book_shelf_plank" type="box" size="0.33 0.175 0.03"

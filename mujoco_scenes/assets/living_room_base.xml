      <site name="table_place_controller" pos="0.30 0.03 0.487"
            size="0.095 0.075 0.003" type="box"
            material="target_marker" group="4"/>
    </body>

    <!-- Independent rigid clutter rests on the moving tabletop through contact. -->
    <body name="remote_control" pos="-0.18 -0.33 0.502">
      <freejoint name="remote_control_free"/>
      <geom name="remote_control_collision" type="box" size="0.070 0.027 0.012"
            material="remote" mass="0.18" friction="1.1 0.04 0.01"/>
      <geom name="remote_button_1" class="visual" type="cylinder" size="0.006 0.002"

            xyaxes="0.72 -0.69 0 0.42 0.44 0.79" fovy="60"/>
  </worldbody>

  <contact>
    <exclude body1="media_console" body2="media_console_left_drawer"/>
    <exclude body1="media_console" body2="media_console_right_drawer"/>
    <pair name="mug_coaster_support"
          geom1="living_room_mug_collision"
          geom2="coaster_right_collision"
          condim="4" friction="3.0 3.0 0.04 0.01 0.01"
          margin="0.0012" solref="0.004 1"
          solimp="0.99 0.999 0.001"/>
  </contact>

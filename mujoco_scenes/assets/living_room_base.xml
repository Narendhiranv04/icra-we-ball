<mujoco model="google_robot_living_room">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.24 0.25 0.27" diffuse="0.55 0.56 0.58"
               specular="0.12 0.12 0.12"/>
  </visual>

  <default>
    <joint damping="0.8"/>
    <geom condim="4" friction="0.9 0.03 0.01"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>
  </default>

  <asset>
    <texture name="living_sky" type="skybox" builtin="gradient"
             rgb1="0.72 0.82 0.94" rgb2="0.20 0.29 0.43"
             width="512" height="3072"/>
    <texture name="living_floor_tex" type="2d" builtin="checker"
             rgb1="0.56 0.39 0.25" rgb2="0.48 0.32 0.20"
             width="256" height="256" mark="none"/>
    <material name="living_floor" texture="living_floor_tex" texrepeat="8 6"/>
    <material name="media_wall" rgba="0.78 0.82 0.84 1" roughness="0.92"/>
    <material name="rug" rgba="0.66 0.36 0.22 1" roughness="0.95"/>
    <material name="rug_border" rgba="0.74 0.61 0.43 1" roughness="0.95"/>
    <material name="couch_fabric" rgba="0.20 0.40 0.49 1" roughness="0.86"/>
    <material name="couch_frame" rgba="0.11 0.23 0.29 1"/>
    <material name="table_wood" rgba="0.49 0.27 0.12 1" roughness="0.60"/>
    <material name="table_metal" rgba="0.12 0.13 0.14 1" specular="0.45"/>
    <material name="console_wood" rgba="0.38 0.21 0.12 1" roughness="0.58"/>
    <material name="console_face" rgba="0.46 0.27 0.16 1" roughness="0.62"/>
    <material name="brass" rgba="0.72 0.52 0.22 1" specular="0.5" roughness="0.32"/>
    <material name="tv_frame" rgba="0.025 0.028 0.032 1" specular="0.5"/>
    <material name="tv_screen" rgba="0.055 0.075 0.095 1" specular="0.8"/>
    <material name="dust" rgba="0.62 0.62 0.58 0.42"/>
    <material name="dust_film" rgba="0.58 0.55 0.48 0.24" roughness="1"/>
    <material name="remote" rgba="0.08 0.08 0.09 1"/>
    <material name="book" rgba="0.52 0.12 0.09 1"/>
    <material name="ceramic" rgba="0.88 0.87 0.82 1" specular="0.35"/>
    <material name="coaster" rgba="0.24 0.12 0.055 1"/>
    <material name="controller" rgba="0.16 0.16 0.19 1"/>
    <material name="duster_handle" rgba="0.18 0.18 0.20 1"/>
    <material name="duster_head" rgba="0.84 0.68 0.18 1"/>
    <material name="target_marker" rgba="0.18 0.65 0.30 0.16"/>
  </asset>

  <worldbody>
    <light name="ceiling_light" pos="0 -0.45 3.25" dir="0 0 -1"
           diffuse="0.92 0.82 0.70" specular="0.20 0.18 0.16"
           castshadow="true"/>
    <light name="window_fill" pos="1.7 -0.9 2.35" dir="-0.65 0.35 -0.68"
           diffuse="0.48 0.62 0.78" specular="0.12 0.15 0.18"/>
    <light name="media_wall_wash" pos="-1.15 0.65 2.15" dir="0.35 0.55 -0.75"
           diffuse="0.42 0.34 0.27" specular="0.08 0.07 0.06"/>

    <geom name="floor" type="plane" size="2.2 1.85 0.02"
          pos="0 -0.20 0" material="living_floor"/>
    <!-- Full-height north and west walls form the visible room corner.  The
         north wall is set behind the closed drawer backs so storage remains
         collision-free. -->
    <body name="media_feature_wall">
      <geom name="media_feature_wall_panel" type="box" size="2.05 0.035 1.35"
            pos="0 1.48 1.35" material="media_wall"/>
      <geom name="west_feature_wall_panel" type="box" size="0.035 1.75 1.35"
            pos="-2.05 -0.27 1.35" material="media_wall"/>
    </body>

    <!-- A flat, non-colliding area rug lifts the seating group visually
         without changing navigation or manipulation contact. -->
    <body name="living_room_rug">
      <geom name="living_room_rug_border" class="visual" type="box"
            size="1.08 0.91 0.004" pos="0 -0.35 0.007"
            material="rug_border"/>
      <geom name="living_room_rug_field" class="visual" type="box"
            size="1.00 0.83 0.005" pos="0 -0.35 0.012"
            material="rug"/>
    </body>
    <!-- One continuous rigid L-shaped couch.  A square corner module joins
         west and south extensions at exact, non-overlapping seams. -->
    <body name="living_room_couch">
      <geom name="couch_corner_base" type="box" size="0.30 0.30 0.18"
            pos="-1.45 -1.45 0.22" material="couch_frame"/>
      <geom name="couch_west_base" type="box" size="0.30 0.90 0.18"
            pos="-1.45 -0.25 0.22" material="couch_frame"/>
      <geom name="couch_south_base" type="box" size="0.325 0.30 0.18"
            pos="-0.825 -1.45 0.22" material="couch_frame"/>

      <geom name="couch_corner_seat" type="box" size="0.28 0.28 0.09"
            pos="-1.43 -1.43 0.45" material="couch_fabric"/>
      <geom name="couch_west_seat" type="box" size="0.28 0.86 0.09"
            pos="-1.43 -0.29 0.45" material="couch_fabric"/>
      <geom name="couch_south_seat" type="box" size="0.325 0.28 0.09"
            pos="-0.825 -1.43 0.45" material="couch_fabric"/>

      <geom name="couch_west_back" type="box" size="0.08 1.20 0.42"
            pos="-1.74 -0.55 0.72" material="couch_fabric"/>
      <geom name="couch_south_back" type="box" size="0.66 0.08 0.42"
            pos="-1.00 -1.74 0.72" material="couch_fabric"/>
      <geom name="couch_north_arm" type="box" size="0.30 0.08 0.28"
            pos="-1.45 0.73 0.50" material="couch_fabric"/>
      <geom name="couch_east_arm" type="box" size="0.08 0.30 0.28"
            pos="-0.42 -1.45 0.50" material="couch_fabric"/>
    </body>

    <!-- Fixed rigid coffee table. -->
    <body name="coffee_table" pos="0 -0.35 0">
      <geom name="coffee_table_top" type="box" size="0.46 0.28 0.025"
            pos="0 0 0.46" material="table_wood"/>
      <geom name="coffee_table_leg_nw" type="box" size="0.035 0.035 0.205"
            pos="-0.39 0.21 0.23" material="table_metal" mass="1.2"/>
      <geom name="coffee_table_leg_ne" type="box" size="0.035 0.035 0.205"
            pos="0.39 0.21 0.23" material="table_metal" mass="1.2"/>
      <geom name="coffee_table_leg_sw" type="box" size="0.035 0.035 0.205"
            pos="-0.39 -0.21 0.23" material="table_metal" mass="1.2"/>
      <geom name="coffee_table_leg_se" type="box" size="0.035 0.035 0.205"
            pos="0.39 -0.21 0.23" material="table_metal" mass="1.2"/>
      <site name="coffee_table_frame" pos="0 0 0.49" size="0.01"

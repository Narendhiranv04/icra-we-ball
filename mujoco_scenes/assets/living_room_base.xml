      <geom name="dust_screen_film" class="visual" type="box"
            size="0.565 0.001 0.315" pos="0 -0.041 0"
            material="dust_film"/>

      <site name="tv_cell_0" pos="-0.32 -0.060 0.20" size="0.012" rgba="0 0 0 0" group="5"/>

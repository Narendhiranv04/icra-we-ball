      <geom name="game_controller_button_e" class="visual" type="cylinder"
            size="0.005 0.004" pos="0.052 0.006 0.024" rgba="0.72 0.24 0.22 1"/>
      <geom name="game_controller_button_s" class="visual" type="cylinder"

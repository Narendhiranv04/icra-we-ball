  <actuator>
    <position name="left_tool_drawer_actuator" joint="left_tool_drawer_slide"
              kp="300" ctrlrange="0 0.72"/>
    <position name="right_fastener_drawer_actuator" joint="right_fastener_drawer_slide"
              kp="300" ctrlrange="0 0.72"/>
  </actuator>
</mujoco>

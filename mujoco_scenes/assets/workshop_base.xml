      <geom name="right_drawer_handle_col" class="collision" type="capsule"
            fromto="-0.05 -0.22 0.05 0.05 -0.22 0.05" size="0.008"/>
      <site name="right_drawer_handle_grasp" pos="0 -0.22 0.05"

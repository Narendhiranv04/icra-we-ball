<mujoco model="compact workshop joint alternatives">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="8"/>
  </visual>
  <default>
    <geom condim="4" friction="1.0 0.03 0.01"/>
    <joint damping="5"/>
  </default>
  <asset>
    <texture name="workshop_floor_tex" type="2d" builtin="checker"
             rgb1="0.28 0.30 0.32" rgb2="0.20 0.22 0.24"
             width="512" height="512"/>
    <material name="workshop_floor" texture="workshop_floor_tex"
              texrepeat="8 8" reflectance="0.08"/>
    <material name="workshop_wall" rgba="0.76 0.79 0.82 1"/>
    <material name="bench_wood" rgba="0.52 0.28 0.11 1"/>
    <material name="cabinet_blue" rgba="0.10 0.28 0.42 1"/>
    <material name="drawer_blue" rgba="0.16 0.42 0.60 1"/>
    <material name="tool_red" rgba="0.72 0.10 0.08 1"/>
    <material name="tool_yellow" rgba="0.92 0.64 0.06 1"/>
    <material name="steel" rgba="0.66 0.69 0.72 1"/>

            size="0.008 0.20 0.04"/>
    </body>

    <!-- Storage Region 3: TOOL_CABINET (Compact Tabletop Cabinet placed neatly at Back-Right) -->
    <body name="tool_cabinet" pos="0.44 0.56 0.68">
      <geom name="cabinet_bottom" class="visual" type="box" pos="0 0 0.008"
            size="0.22 0.10 0.008" material="cabinet_body_mat"/>
      <geom name="cabinet_top" class="visual" type="box" pos="0 0 0.65"

<mujoco model="integrated single arm workshop repair cell">
  <compiler angle="radian" meshdir="workshop_realistic" texturedir="workshop_realistic"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="10"/>
    <headlight ambient="0.32 0.32 0.32" diffuse="0.58 0.58 0.58" specular="0.15 0.15 0.15"/>
  </visual>
  <default>
    <geom condim="4" friction="1.0 0.03 0.01"/>
    <joint damping="6"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
    </default>
  </default>

  <asset>
    <!-- Environmental Textures and Materials -->
    <texture name="shop_floor_tex" type="2d" builtin="checker"
             rgb1="0.28 0.29 0.31" rgb2="0.22 0.23 0.25"
             width="512" height="512" mark="none"/>
    <texture name="shop_wall_tex" type="2d" builtin="gradient"
             rgb1="0.82 0.85 0.88" rgb2="0.65 0.68 0.72"
             width="512" height="512"/>
    <material name="shop_floor" texture="shop_floor_tex"
              texrepeat="12 12" reflectance="0.06"/>
    <material name="shop_wall" texture="shop_wall_tex"
              texuniform="true"/>
    <material name="cabinet_body_mat" rgba="0.18 0.22 0.26 1" reflectance="0.18"/>
    <material name="cabinet_face_mat" rgba="0.22 0.28 0.35 1" reflectance="0.22"/>
    <material name="cabinet_interior_mat" rgba="0.48 0.50 0.54 1"/>
    <material name="fixture_anodized" rgba="0.18 0.20 0.23 1" reflectance="0.25"/>
    <material name="fixture_clamp_mat" rgba="0.28 0.32 0.38 1" reflectance="0.30"/>
    <material name="pegboard_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="shelf_wood" rgba="0.58 0.40 0.26 1"/>
    <material name="wood_frame_mat" rgba="0.65 0.46 0.26 1"/>
    <material name="dark_steel" rgba="0.18 0.20 0.22 1" reflectance="0.15"/>
    <material name="target_hole_mat" rgba="0.05 0.05 0.06 1"/>
    <material name="polished_steel" rgba="0.80 0.82 0.85 1" reflectance="0.45"/>
    <material name="obstruction_case_mat" rgba="0.15 0.17 0.20 1" reflectance="0.15"/>

    <!-- Mesh Assets from assets/workshop_realistic/ -->
    <mesh name="workbench_mesh" file="wooden_table_02.obj"/>
    <mesh name="tool_cart_mesh" file="tool_cart.obj"/>
    <mesh name="parts_tray_mesh" file="workshop_parts_tray.obj"/>
    <mesh name="hardware_bin_mesh" file="workshop_hardware_bin.obj"/>
    <mesh name="long_driver_mesh" file="workshop_long_phillips_driver.obj"/>
    <mesh name="stubby_driver_mesh" file="workshop_stubby_phillips_driver.obj"/>
    <mesh name="flathead_driver_mesh" file="screwdriver.obj"/>
    <mesh name="power_driver_mesh" file="Drill_01.obj"/>
    <mesh name="wooden_hammer_mesh" file="wooden_hammer_01.obj"/>
    <mesh name="pliers_mesh" file="pliers.obj"/>
    <mesh name="combination_wrench_mesh" file="combination_wrench.obj"/>
    <mesh name="medium_screw_mesh" file="workshop_medium_phillips_screw.obj"/>
    <mesh name="short_screw_mesh" file="workshop_short_phillips_screw.obj"/>
    <mesh name="hex_bolt_mesh" file="workshop_hex_bolt.obj"/>

    <!-- Textures for realistic rendering -->
    <texture name="workbench_tex" type="2d" file="wooden_table_02_diff.png"/>
    <texture name="tool_cart_tex" type="2d" file="tool_cart_diff.png"/>
    <texture name="parts_tray_tex" type="2d" file="workshop_parts_tray_diff.png"/>
    <texture name="hardware_bin_tex" type="2d" file="workshop_hardware_bin_diff.png"/>
    <texture name="screwdrivers_tex" type="2d" file="screwdrivers_02_diff.png"/>
    <texture name="screwdriver_tex" type="2d" file="screwdriver_diff.png"/>
    <texture name="drill_tex" type="2d" file="Drill_01_diff.png"/>
    <texture name="wooden_hammer_tex" type="2d" file="wooden_hammer_01_diff.png"/>
    <texture name="pliers_tex" type="2d" file="pliers_diff.png"/>
    <texture name="wrench_tex" type="2d" file="combination_wrench_diff.png"/>

    <material name="workbench_visual_mat" texture="workbench_tex"/>
    <material name="tool_cart_visual_mat" texture="tool_cart_tex" specular="0.15" shininess="0.2"/>
    <material name="parts_tray_visual_mat" texture="parts_tray_tex"/>
    <material name="hardware_bin_visual_mat" texture="hardware_bin_tex"/>
    <material name="screwdrivers_visual_mat" texture="screwdrivers_tex"/>
    <material name="screwdriver_visual_mat" texture="screwdriver_tex"/>
    <material name="drill_visual_mat" texture="drill_tex"/>
    <material name="wooden_hammer_visual_mat" texture="wooden_hammer_tex"/>
    <material name="pliers_visual_mat" texture="pliers_tex"/>
    <material name="wrench_visual_mat" texture="wrench_tex"/>
  </asset>

  <worldbody>
    <!-- Studio Workshop Key & Fill Lighting -->
    <light name="workshop_main_light" pos="-1.2 -1.0 3.0" dir="0.35 0.35 -1"
           directional="true" diffuse="0.88 0.86 0.82" specular="0.25 0.25 0.25" castshadow="true"/>
    <light name="workshop_fill_light" pos="1.5 -0.6 2.6" dir="-0.4 0.2 -1"
           directional="true" diffuse="0.52 0.58 0.68" specular="0.12 0.12 0.12"/>
    <light name="workshop_bench_light" pos="0 0.35 2.2"
           diffuse="0.68 0.65 0.58" specular="0.20 0.20 0.20"/>

    <!-- Room Geometry -->
    <geom name="workshop_floor_geom" type="plane" size="2.5 2.5 0.05"
          material="shop_floor"/>
    <geom name="workshop_north_wall" class="visual" type="box" pos="0 1.45 1.3"
          size="2.4 0.04 1.3" material="shop_wall"/>
    <geom name="workshop_west_wall" class="visual" type="box" pos="-2.2 0 1.3"
          size="0.04 1.5 1.3" material="shop_wall"/>
    <geom name="workshop_east_wall" class="visual" type="box" pos="2.2 0 1.3"
          size="0.04 1.5 1.3" material="shop_wall"/>

    <!-- Realistic Heavy-Duty Workbench with Textured Mesh Visual + Invisible Collision Proxies -->
    <body name="workbench" pos="0 0.38 0">
      <!-- Visual Textured Workbench Mesh -->
      <geom name="workbench_visual" class="visual" type="mesh" mesh="workbench_mesh"
            material="workbench_visual_mat"/>
      <!-- Invisible Physical Collision Proxies -->
      <geom name="workbench_top_col" class="collision" type="box" pos="0 0 0.66"
            size="0.60 0.325 0.02"/>
      <geom name="workbench_leg_fl_col" class="collision" type="box" pos="-0.56 -0.28 0.32"
            size="0.04 0.04 0.32"/>
      <geom name="workbench_leg_fr_col" class="collision" type="box" pos="0.56 -0.28 0.32"
            size="0.04 0.04 0.32"/>
      <geom name="workbench_leg_bl_col" class="collision" type="box" pos="-0.56 0.28 0.32"
            size="0.04 0.04 0.32"/>
      <geom name="workbench_leg_br_col" class="collision" type="box" pos="0.56 0.28 0.32"
            size="0.04 0.04 0.32"/>
      <!-- Clean under-bench cabinet housing for the drawers -->
      <geom name="drawer_housing_left" class="visual" type="box" pos="-0.28 0.02 0.44"
            size="0.20 0.24 0.18" material="cabinet_body_mat"/>
      <geom name="drawer_housing_right" class="visual" type="box" pos="0.28 0.02 0.44"
            size="0.20 0.24 0.18" material="cabinet_body_mat"/>
    </body>

    <!-- Perforated Industrial Pegboard behind Workbench (Clean, proportionate background) -->
    <body name="workshop_pegboard" pos="0 0.70 1.05">
      <geom name="pegboard_back" class="visual" type="box" size="0.45 0.015 0.22"
            material="pegboard_mat"/>
      <geom name="pegboard_frame_top" class="visual" type="box" pos="0 -0.020 0.21"
            size="0.45 0.012 0.012" material="dark_steel"/>
      <geom name="pegboard_frame_bot" class="visual" type="box" pos="0 -0.020 -0.21"
            size="0.45 0.012 0.012" material="dark_steel"/>
      <geom name="pegboard_frame_l" class="visual" type="box" pos="-0.44 -0.020 0"
            size="0.012 0.012 0.21" material="dark_steel"/>
      <geom name="pegboard_frame_r" class="visual" type="box" pos="0.44 -0.020 0"
            size="0.012 0.012 0.21" material="dark_steel"/>
    </body>

    <!-- Rolling Industrial Tool Cart: Alternative Work Surface (WORK_SURFACE candidate) -->
    <body name="workshop_tool_cart" pos="1.28 0.40 0">
      <geom name="tool_cart_visual" class="visual" type="mesh" mesh="tool_cart_mesh"
            material="tool_cart_visual_mat"/>
      <geom name="tool_cart_top_col" class="collision" type="box" pos="0 0 0.80"
            size="0.32 0.21 0.02"/>
      <geom name="tool_cart_body_col" class="collision" type="box" pos="0 0 0.40"
            size="0.30 0.20 0.38"/>
    </body>

    <!-- Clean Sleek Industrial Frame Fixture & Workpiece Target Joint (Anchored at Back-Left-Center) -->
    <body name="workshop_frame_fixture" pos="-0.15 0.50 0.68">
      <!-- Split fixture base visual: solid bottom slab (0..8mm) + hollow top slab (8..16mm) surrounding target hole -->
      <geom name="fixture_base_bottom_vis" class="visual" type="box" pos="0 0 0.004"
            size="0.16 0.10 0.004" material="fixture_anodized"/>
      <geom name="fixture_base_top_l_vis" class="visual" type="box" pos="-0.131875 0 0.012"
            size="0.028125 0.10 0.004" material="fixture_anodized"/>
      <geom name="fixture_base_top_r_vis" class="visual" type="box" pos="0.031875 0 0.012"
            size="0.128125 0.10 0.004" material="fixture_anodized"/>
      <geom name="fixture_base_top_f_vis" class="visual" type="box" pos="-0.10 -0.061875 0.012"
            size="0.00375 0.038125 0.004" material="fixture_anodized"/>
      <geom name="fixture_base_top_b_vis" class="visual" type="box" pos="-0.10 0.041875 0.012"
            size="0.00375 0.058125 0.004" material="fixture_anodized"/>
      <!-- Split fixture base collision: solid bottom slab (0..8mm) + hollow top slab (8..16mm) -->
      <geom name="fixture_base_bottom_col" class="collision" type="box" pos="0 0 0.004"
            size="0.16 0.10 0.004"/>
      <geom name="fixture_base_top_l_col" class="collision" type="box" pos="-0.131875 0 0.012"
            size="0.028125 0.10 0.004"/>
      <geom name="fixture_base_top_r_col" class="collision" type="box" pos="0.031875 0 0.012"
            size="0.128125 0.10 0.004"/>
      <geom name="fixture_base_top_f_col" class="collision" type="box" pos="-0.10 -0.061875 0.012"
            size="0.00375 0.038125 0.004"/>
      <geom name="fixture_base_top_b_col" class="collision" type="box" pos="-0.10 0.041875 0.012"
            size="0.00375 0.058125 0.004"/>

      <geom name="fixture_clamp" class="visual" type="box" pos="0.10 -0.02 0.024"
            size="0.025 0.035 0.012" material="fixture_clamp_mat"/>
      <geom name="fixture_clamp_col" class="collision" type="box" pos="0.10 -0.02 0.024"
            size="0.025 0.035 0.012"/>

      <!-- Immobilized Frame Joint Workpiece -->
      <body name="workshop_frame_joint" pos="0 0 0.016">
        <!-- Canonical repair landmarks.  The screw origin is its tip, so the
             seated site is one 30 mm engagement depth below the entry. -->
        <site name="workshop_target_hole_entry" pos="-0.10 -0.02 0.023"
              size="0.0035 0.002" type="cylinder" rgba="0.15 0.75 1 0.35"/>
        <site name="workshop_target_hole_seated_tip" pos="-0.10 -0.02 -0.007"
              size="0.002 0.002" type="sphere" rgba="0.1 1 0.25 0.35"/>
        <!-- Split horizontal wood rail visual surrounding the 7mm target hole at x=-0.10, y=-0.02 -->
        <geom name="frame_h_rail_l_vis" class="visual" type="box" pos="-0.121875 -0.02 0.010"
              size="0.018125 0.024 0.010" material="wood_frame_mat"/>
        <geom name="frame_h_rail_r_vis" class="visual" type="box" pos="0.021875 -0.02 0.010"
              size="0.118125 0.024 0.010" material="wood_frame_mat"/>
        <geom name="frame_h_rail_f_vis" class="visual" type="box" pos="-0.10 -0.033875 0.010"
              size="0.00375 0.010125 0.010" material="wood_frame_mat"/>
        <geom name="frame_h_rail_b_vis" class="visual" type="box" pos="-0.10 -0.006125 0.010"
              size="0.00375 0.010125 0.010" material="wood_frame_mat"/>
        <!-- Split horizontal wood rail collision surrounding the 7mm target hole at x=-0.10, y=-0.02 -->
        <geom name="frame_h_rail_l_col" class="collision" type="box" pos="-0.121875 -0.02 0.010"
              size="0.018125 0.024 0.010"/>
        <geom name="frame_h_rail_r_col" class="collision" type="box" pos="0.021875 -0.02 0.010"
              size="0.118125 0.024 0.010"/>
        <geom name="frame_h_rail_f_col" class="collision" type="box" pos="-0.10 -0.033875 0.010"
              size="0.00375 0.010125 0.010"/>
        <geom name="frame_h_rail_b_col" class="collision" type="box" pos="-0.10 -0.006125 0.010"
              size="0.00375 0.010125 0.010"/>

        <geom name="frame_vertical_rail" class="visual" type="box" pos="-0.10 0.04 0.010"
              size="0.024 0.050 0.010" material="wood_frame_mat"/>
        <geom name="frame_vertical_rail_col" class="collision" type="box" pos="-0.10 0.04 0.010"
              size="0.024 0.050 0.010"/>

        <!-- Split bracket visual surrounding the 7mm target hole at x=-0.10, y=-0.02 -->
        <geom name="frame_bracket_l_vis" class="visual" type="box" pos="-0.116875 -0.02 0.021"
              size="0.013125 0.030 0.002" material="dark_steel"/>
        <geom name="frame_bracket_r_vis" class="visual" type="box" pos="-0.083125 -0.02 0.021"
              size="0.013125 0.030 0.002" material="dark_steel"/>
        <geom name="frame_bracket_f_vis" class="visual" type="box" pos="-0.10 -0.036875 0.021"
              size="0.00375 0.013125 0.002" material="dark_steel"/>
        <geom name="frame_bracket_b_vis" class="visual" type="box" pos="-0.10 -0.003125 0.021"
              size="0.00375 0.013125 0.002" material="dark_steel"/>
        <!-- Split bracket collision surrounding the 7mm target hole at x=-0.10, y=-0.02 -->
        <geom name="frame_bracket_l_col" class="collision" type="box" pos="-0.116875 -0.02 0.021"
              size="0.013125 0.030 0.002"/>
        <geom name="frame_bracket_r_col" class="collision" type="box" pos="-0.083125 -0.02 0.021"
              size="0.013125 0.030 0.002"/>
        <geom name="frame_bracket_f_col" class="collision" type="box" pos="-0.10 -0.036875 0.021"
              size="0.00375 0.013125 0.002"/>
        <geom name="frame_bracket_b_col" class="collision" type="box" pos="-0.10 -0.003125 0.021"
              size="0.00375 0.013125 0.002"/>

        <!-- Clear recessed target screw hole: 7mm diameter (3.5mm radius), 30mm depth with dark bottom surface -->
        <geom name="frame_target_hole_bottom" class="visual" type="cylinder" pos="-0.10 -0.02 -0.007"
              size="0.0035 0.0005" material="target_hole_mat"/>
      </body>
    </body>

    <!-- Parts Staging Tray: SMALL_PARTS_CONTAINER Candidate (Front-Left Tabletop) -->
    <body name="workshop_parts_tray" pos="-0.42 0.22 0.68">
      <geom name="parts_tray_visual" class="visual" type="mesh" mesh="parts_tray_mesh"
            material="parts_tray_visual_mat"/>
      <!-- Invisible hollow collision proxies -->
      <geom name="parts_tray_base_col" class="collision" type="box" pos="0 0 0.004"
            size="0.11 0.07 0.004"/>
      <geom name="parts_tray_wall_l_col" class="collision" type="box" pos="-0.106 0 0.018"
            size="0.004 0.07 0.014"/>

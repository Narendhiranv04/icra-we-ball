            size="0.07 0.34 0.27" material="cabinet_blue"/>
      <geom name="workbench_right_leg" type="box" pos="0.88 0.42 0.27"
            size="0.07 0.34 0.27" material="cabinet_blue"/>
      <geom name="workbench_back" type="box" pos="0 0.79 0.34"
            size="0.92 0.035 0.20" material="cabinet_blue"/>

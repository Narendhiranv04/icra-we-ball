      <geom name="parts_tray_wall_f_col" class="collision" type="box" pos="0 -0.066 0.018"
            size="0.11 0.004 0.014"/>
      <geom name="parts_tray_wall_b_col" class="collision" type="box" pos="0 0.066 0.018"
            size="0.11 0.004 0.014"/>
    </body>

    <!-- Small Hardware Storage Bin: SMALL_PARTS_CONTAINER Candidate (Back-Left Tabletop) -->
    <body name="workshop_hardware_bin" pos="-0.44 0.52 0.68">
      <geom name="hardware_bin_visual" class="visual" type="mesh" mesh="hardware_bin_mesh"
            material="hardware_bin_visual_mat"/>
      <!-- Invisible hollow collision proxies -->
      <geom name="hardware_bin_base_col" class="collision" type="box" pos="0 0 0.003"
            size="0.055 0.075 0.003"/>
      <geom name="hardware_bin_wall_l_col" class="collision" type="box" pos="-0.052 0 0.03"
            size="0.003 0.075 0.03"/>
      <geom name="hardware_bin_wall_r_col" class="collision" type="box" pos="0.052 0 0.03"
            size="0.003 0.075 0.03"/>
      <geom name="hardware_bin_wall_b_col" class="collision" type="box" pos="0 0.072 0.04"
            size="0.055 0.003 0.04"/>
      <geom name="hardware_bin_wall_f_col" class="collision" type="box" pos="0 -0.072 0.019"
            size="0.055 0.003 0.019"/>
    </body>

    <!-- Storage Region 1: LEFT_DRAWER (Prismatic sliding drawer) -->
    <body name="left_tool_drawer" pos="-0.28 0.35 0.46">
      <joint name="left_tool_drawer_slide" type="slide" axis="0 -1 0"
             range="0 0.55" limited="true" damping="8"/>
      <geom name="left_drawer_floor" class="visual" type="box" pos="0 0 0"
            size="0.16 0.20 0.012" material="cabinet_interior_mat"/>
      <geom name="left_drawer_front" class="visual" type="box" pos="0 -0.20 0.05"
            size="0.18 0.012 0.07" material="cabinet_face_mat"/>
      <geom name="left_drawer_back" class="visual" type="box" pos="0 0.19 0.04"
            size="0.16 0.01 0.04" material="cabinet_interior_mat"/>
      <geom name="left_drawer_side_l" class="visual" type="box" pos="-0.15 0 0.04"

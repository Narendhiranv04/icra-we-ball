      <!-- Invisible collision proxies -->
      <geom name="right_drawer_col_floor" class="collision" type="box" pos="0 0 0"
            size="0.16 0.20 0.012"/>
      <geom name="right_drawer_col_front" class="collision" type="box" pos="0 -0.205 0.05"
            size="0.17 0.008 0.06"/>
      <geom name="right_drawer_col_back" class="collision" type="box" pos="0 0.205 0.04"

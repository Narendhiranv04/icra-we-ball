      <geom name="left_drawer_side_r" class="visual" type="box" pos="0.15 0 0.04"
            size="0.01 0.19 0.04" material="cabinet_interior_mat"/>
      <geom name="left_drawer_handle" class="visual" type="capsule"
            fromto="-0.05 -0.22 0.05 0.05 -0.22 0.05" size="0.008"
            material="polished_steel"/>
      <geom name="left_drawer_handle_col" class="collision" type="capsule"
            fromto="-0.05 -0.22 0.05 0.05 -0.22 0.05" size="0.008"/>
      <site name="left_drawer_handle_grasp" pos="0 -0.22 0.05"
            size="0.005" rgba="0 0 0 0"/>
      <!-- Invisible collision proxies -->
      <geom name="left_drawer_col_floor" class="collision" type="box" pos="0 0 0"
            size="0.16 0.20 0.012"/>
      <geom name="left_drawer_col_front" class="collision" type="box" pos="0 -0.205 0.05"
            size="0.17 0.008 0.06"/>
      <geom name="left_drawer_col_back" class="collision" type="box" pos="0 0.205 0.04"
            size="0.16 0.008 0.04"/>
      <geom name="left_drawer_col_side_l" class="collision" type="box" pos="-0.165 0 0.04"
            size="0.008 0.20 0.04"/>
      <geom name="left_drawer_col_side_r" class="collision" type="box" pos="0.165 0 0.04"
            size="0.008 0.20 0.04"/>
    </body>

    <!-- Storage Region 2: RIGHT_DRAWER (Prismatic sliding drawer) -->
    <body name="right_tool_drawer" pos="0.28 0.35 0.46">
      <joint name="right_tool_drawer_slide" type="slide" axis="0 -1 0"
             range="0 0.55" limited="true" damping="8"/>
      <geom name="right_drawer_floor" class="visual" type="box" pos="0 0 0"
            size="0.16 0.20 0.012" material="cabinet_interior_mat"/>
      <geom name="right_drawer_front" class="visual" type="box" pos="0 -0.20 0.05"
            size="0.18 0.012 0.07" material="cabinet_face_mat"/>
      <geom name="right_drawer_back" class="visual" type="box" pos="0 0.19 0.04"
            size="0.16 0.01 0.04" material="cabinet_interior_mat"/>
      <geom name="right_drawer_side_l" class="visual" type="box" pos="-0.15 0 0.04"
            size="0.01 0.19 0.04" material="cabinet_interior_mat"/>
      <geom name="right_drawer_side_r" class="visual" type="box" pos="0.15 0 0.04"
            size="0.01 0.19 0.04" material="cabinet_interior_mat"/>
      <geom name="right_drawer_handle" class="visual" type="capsule"
            fromto="-0.05 -0.22 0.05 0.05 -0.22 0.05" size="0.008"

<mujoco model="L2 living room region grounding">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="8"/>
  </visual>
  <default>
    <geom condim="4" friction="1.0 0.03 0.01"/>
    <joint damping="1"/>
  </default>
  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.52 0.42 0.31" rgb2="0.42 0.33 0.25"
             width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8"
              reflectance="0.04"/>
    <texture name="rug_tex" type="2d" builtin="checker"
             rgb1="0.08 0.25 0.52" rgb2="0.88 0.72 0.28"
             mark="edge" markrgb="0.95 0.86 0.55"
             width="512" height="512"/>
    <material name="rug_mat" texture="rug_tex" texrepeat="6 5"
              reflectance="0.02"/>
    <material name="wood" rgba="0.48 0.20 0.07 1"/>
    <material name="wood_light" rgba="0.72 0.42 0.18 1"/>
    <material name="sofa" rgba="0.12 0.38 0.58 1"/>
    <material name="tray" rgba="0.92 0.26 0.08 1"/>
    <material name="metal" rgba="0.75 0.78 0.80 1"/>
    <material name="tv" rgba="0.025 0.03 0.04 1"/>
    <material name="wall" rgba="0.86 0.88 0.90 1"/>
    <material name="marker" rgba="0.15 0.85 0.30 0.25"/>
  </asset>
  <worldbody>
    <light name="key" pos="-1.5 -1.8 3.8" dir="0.3 0.4 -1"
           directional="true" diffuse="0.85 0.82 0.78"/>
    <light name="fill" pos="1.8 -0.8 2.8" dir="-0.4 0.2 -1"
           directional="true" diffuse="0.58 0.66 0.78"/>
    <light name="north_fill" pos="0 1.6 2.6" dir="0 -0.5 -1"
           diffuse="0.48 0.48 0.42"/>

    <geom name="room_floor" type="plane" size="2.4 2.2 0.05"
          material="floor_mat"/>
    <geom name="north_wall" type="box" pos="0 1.65 1.35"
          size="2.3 0.04 1.35" material="wall"/>
    <geom name="west_wall" type="box" pos="-2.15 0 1.35"
          size="0.04 1.65 1.35" material="wall"/>

    <!-- Clearly visible seating context. -->
    <body name="l2_sofa">
      <geom name="l2_sofa_base" type="box" pos="-0.62 0.82 0.22"
            size="0.78 0.34 0.22" material="sofa"/>
      <geom name="l2_sofa_seat" type="box" pos="-0.62 0.72 0.48"
            size="0.72 0.28 0.08" material="sofa"/>
      <geom name="l2_sofa_back" type="box" pos="-0.62 1.08 0.88"
            size="0.78 0.10 0.48" material="sofa"/>
      <geom name="l2_sofa_left_arm" type="box" pos="-1.43 0.76 0.60"
            size="0.09 0.34 0.30" material="sofa"/>
      <geom name="l2_sofa_right_arm" type="box" pos="0.19 0.76 0.60"
            size="0.09 0.34 0.30" material="sofa"/>
    </body>

    <!-- Geometry-only counterexample: large, planar rug near the sofa. -->
    <body name="l2_rug">
      <geom name="l2_rug_surface" type="box" pos="-0.15 -0.18 0.012"
            size="0.72 0.48 0.012" material="rug_mat"
            contype="0" conaffinity="0"/>
      <geom name="l2_rug_border" type="box" pos="-0.15 -0.18 0.008"
            size="0.76 0.52 0.008" rgba="0.90 0.73 0.30 1"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Semantic-only counterexample: recognizable but undersized end table. -->
    <body name="l2_side_table">
      <geom name="l2_side_table_top" type="box" pos="-1.28 0.20 0.57"
            size="0.155 0.135 0.035" material="wood_light"/>
      <geom name="l2_side_table_leg" type="cylinder" pos="-1.28 0.20 0.29"
            size="0.055 0.25" material="wood"/>
      <geom name="l2_side_table_foot" type="box" pos="-1.28 0.20 0.045"
            size="0.13 0.11 0.025" material="wood"/>
    </body>

    <!-- Correct joint solution: clear coffee-table support patch. -->
    <body name="l2_coffee_table">
      <geom name="l2_coffee_table_top" type="box" pos="0.42 0.20 0.48"
            size="0.36 0.28 0.04" material="wood_light"/>
      <geom name="l2_coffee_leg_fl" type="box" pos="0.15 -0.01 0.23"
            size="0.035 0.035 0.23" material="wood"/>
      <geom name="l2_coffee_leg_fr" type="box" pos="0.69 -0.01 0.23"
            size="0.035 0.035 0.23" material="wood"/>
      <geom name="l2_coffee_leg_bl" type="box" pos="0.15 0.41 0.23"
            size="0.035 0.035 0.23" material="wood"/>
      <geom name="l2_coffee_leg_br" type="box" pos="0.69 0.41 0.23"
            size="0.035 0.035 0.23" material="wood"/>
    </body>

    <!-- Payload staging support is deliberately outside the candidate domain. -->
    <body name="l2_staging_table">
      <geom name="l2_staging_top" type="box" pos="1.16 -0.70 0.50"
            size="0.34 0.24 0.035" material="metal"/>
      <geom name="l2_staging_leg" type="cylinder" pos="1.16 -0.70 0.24"
            size="0.055 0.24" material="metal"/>
    </body>
    <body name="l2_refreshment_tray" pos="1.16 -0.70 0.565">
      <freejoint name="l2_refreshment_tray_free"/>
      <geom name="l2_tray_base" type="box" size="0.205 0.135 0.012"
            material="tray" mass="0.65"/>
      <geom name="l2_tray_north_rim" type="box" pos="0 0.132 0.025"
            size="0.205 0.010 0.025" material="tray" mass="0.04"/>
      <geom name="l2_tray_south_rim" type="box" pos="0 -0.132 0.025"
            size="0.205 0.010 0.025" material="tray" mass="0.04"/>
      <geom name="l2_tray_east_rim" type="box" pos="0.202 0 0.025"
            size="0.010 0.125 0.025" material="tray" mass="0.04"/>
      <geom name="l2_tray_west_rim" type="box" pos="-0.202 0 0.025"
            size="0.010 0.125 0.025" material="tray" mass="0.04"/>
    </body>

    <body name="l2_media_wall">
      <geom name="l2_media_console" type="box" pos="0.85 1.35 0.34"
            size="0.58 0.20 0.30" material="wood"/>
      <geom name="l2_tv_frame" type="box" pos="0.85 1.48 1.10"
            size="0.55 0.035 0.34" material="tv"/>
    </body>

    <!-- Five scene-owned cameras are deterministically repositioned per region. -->
    <camera name="l2_camera_left" pos="-1.2 -1.4 1.4"
            xyaxes="0.8 -0.6 0 0.3 0.4 0.86" fovy="62"/>
    <camera name="l2_camera_right" pos="1.2 -1.4 1.4"
            xyaxes="0.8 0.6 0 -0.3 0.4 0.86" fovy="62"/>
    <camera name="l2_camera_top" pos="0 0 3.4"
            xyaxes="1 0 0 0 1 0" fovy="62"/>
    <camera name="l2_camera_front" pos="0 -1.8 1.1"
            xyaxes="1 0 0 0 0.5 0.866" fovy="62"/>
    <camera name="l2_camera_close" pos="0.7 -1.0 1.2"
            xyaxes="0.8 0.6 0 -0.4 0.53 0.75" fovy="60"/>
  </worldbody>
  <actuator/>
</mujoco>

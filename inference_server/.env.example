# Required. Generate with: openssl rand -hex 32
INFERENCE_API_KEY=replace-with-a-long-random-key

# Host settings
INFERENCE_PORT=8000
PLANNER_PORT=8080
CUDA_VISIBLE_DEVICES=0
CACHE_DIR=./cache
MODEL_DIR=./models

# Optional for gated Hugging Face checkpoints.
HF_TOKEN=

# Container versions. Pin these to a tested digest for long experiments.
VLLM_IMAGE=vllm/vllm-openai:v0.24.0
SGLANG_IMAGE=lmsysorg/sglang:latest
PLANNER_IMAGE=python:3.12-slim

# Optional separate key for clients of the functional API. If empty, the
# inference key above is used for both layers.
PLANNER_API_KEY=
PLANNER_MODEL_TIMEOUT_SECONDS=300
PLANNER_MAX_TOKENS=8192
PLANNER_ENABLE_THINKING=true

# Optional memory overrides. Profile defaults target one 32 GB RTX 5090.
INFERENCE_TENSOR_PARALLEL_SIZE=1
INFERENCE_GPU_MEMORY_UTILIZATION=0.90
# INFERENCE_MAX_MODEL_LEN=8192
# INFERENCE_MAX_CONCURRENCY=1

# Optional local checkpoint or alternate served name.
# INFERENCE_MODEL_ID=/models/checkpoint
# INFERENCE_SERVED_NAME=custom-name
